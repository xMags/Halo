!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml

!apps/
apps/*
# pnpm reads every patchedDependencies file at install, even for an API-only
# filter, so the mobile app's patches must be in the context.
!apps/mobile/
apps/mobile/*
!apps/mobile/patches/
!apps/mobile/patches/**
!apps/api/
apps/api/*
!apps/api/package.json
!apps/api/src/
!apps/api/src/**
!apps/api/drizzle/
!apps/api/drizzle/**

!packages/
packages/*
!packages/core/
packages/core/*
!packages/core/package.json
!packages/core/src/
!packages/core/src/**
