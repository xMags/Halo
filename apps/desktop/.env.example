# The Halo server this build signs in to. Copy this file to .env.local (never
# committed) and set it before `tauri dev` or `tauri build`; the build stops if
# it is missing. One build, one server: the sign-in screen offers only the
# sign-in that server asks for. An environment variable of the same name
# overrides the file, e.g. for a local test server on http://127.0.0.1:18790.
VITE_HALO_SERVER_URL=https://halo.example.com
