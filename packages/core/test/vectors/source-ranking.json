  "lineSpeed": [
    { "name": "a session that measured nothing keeps the reading", "previous": 50, "sessionPeak": 0, "stalled": false, "expect": 50 },
    { "name": "a negative peak keeps the reading, stall or not", "previous": 50, "sessionPeak": -3, "stalled": true, "expect": 50 },
    { "name": "nothing measured, ever, stays unmeasured", "previous": 0, "sessionPeak": 0, "stalled": false, "expect": 0 },
    { "name": "the first reading is taken as it is", "previous": 0, "sessionPeak": 30, "stalled": false, "expect": 30 },
    { "name": "a broken previous reading is replaced", "previous": -1, "sessionPeak": 30, "stalled": false, "expect": 30 },
    { "name": "a faster peak replaces the reading", "previous": 30, "sessionPeak": 80, "stalled": false, "expect": 80 },
    { "name": "a faster peak replaces the reading after a stall too", "previous": 30, "sessionPeak": 80, "stalled": true, "expect": 80 },
    { "name": "a stall takes the slower peak", "previous": 80, "sessionPeak": 20, "stalled": true, "expect": 20 },
    { "name": "a slower peak without a stall keeps the reading", "previous": 80, "sessionPeak": 20, "stalled": false, "expect": 80 },
    { "name": "an equal peak keeps the reading", "previous": 50, "sessionPeak": 50, "stalled": false, "expect": 50 },
    { "name": "a tiny first reading is raised to the lower bound", "previous": 0, "sessionPeak": 0.2, "stalled": false, "expect": 0.5 },
    { "name": "a stall below the lower bound is raised to it", "previous": 80, "sessionPeak": 0.1, "stalled": true, "expect": 0.5 },
    { "name": "a huge first reading is lowered to the upper bound", "previous": 0, "sessionPeak": 250000, "stalled": false, "expect": 100000 },
    { "name": "a kept reading above the upper bound is lowered to it", "previous": 200000, "sessionPeak": 10, "stalled": false, "expect": 100000 },
    { "name": "a kept reading below the lower bound is raised to it", "previous": 0.25, "sessionPeak": 0.1, "stalled": false, "expect": 0.5 }
  ]
}
